rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to get current user's profile
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isSupremeAdmin() {
      return getUserData().role == 'supreme_admin';
    }
    
    function isPrincipal() {
      return getUserData().role == 'principal';
    }

    function isTeacher() {
      return getUserData().role == 'teacher';
    }

    function isSameSchool(resourceSchoolID) {
      return getUserData().schoolID == resourceSchoolID;
    }
    
    function isSameSchoolByName(resourceSchoolName) {
      return getUserData().schoolName == resourceSchoolName;
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (isSupremeAdmin() || isPrincipal());
    }

    match /{path=**}/principals/{document} {
      allow read: if request.auth != null && (isSupremeAdmin() || isSameSchool(resource.data.schoolID));
      allow write: if request.auth != null && isSupremeAdmin();
    }
    
    match /{path=**}/teachers/{document} {
      allow read: if request.auth != null && (isSupremeAdmin() || isSameSchool(resource.data.schoolID));
      allow write: if request.auth != null && (isSupremeAdmin() || (isPrincipal() && isSameSchool(resource.data.schoolID)));
    }
    
    match /{path=**}/admins/{document} {
      allow read: if request.auth != null && (isSupremeAdmin() || isSameSchool(resource.data.schoolID));
      allow write: if request.auth != null && isSupremeAdmin();
    }
    
    match /{path=**}/users/{document} {
      // This is the students collection as per getRoleCollection(UserRole.STUDENT) -> 'users'
      allow read: if request.auth != null && (isSupremeAdmin() || isSameSchool(resource.data.schoolID));
      allow write: if request.auth != null && (isSupremeAdmin() || ((isPrincipal() || isTeacher()) && isSameSchool(resource.data.schoolID)));
    }
    
    match /{path=**}/students/{document} {
      allow read: if request.auth != null && (isSupremeAdmin() || isSameSchool(resource.data.schoolID));
      allow write: if request.auth != null && (isSupremeAdmin() || ((isPrincipal() || isTeacher()) && isSameSchool(resource.data.schoolID)));
    }

    match /schools/{schoolId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isSupremeAdmin();
    }
    
    match /announcements/{document} {
      allow read: if request.auth != null && (isSupremeAdmin() || resource.data.schoolName == getUserData().schoolName || resource.data.schoolName == "All Schools" || !("schoolName" in resource.data));
      allow write: if request.auth != null && (isSupremeAdmin() || isPrincipal());
    }
    
    match /assignments/{document} {
      allow read: if request.auth != null && (isSupremeAdmin() || isSameSchoolByName(resource.data.schoolName));
      allow write: if request.auth != null && (isSupremeAdmin() || ((isPrincipal() || isTeacher()) && isSameSchoolByName(resource.data.schoolName)) || (getUserData().role == 'student' && isSameSchoolByName(resource.data.schoolName)));
    }
    
    match /messages/{document} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    match /payments/{document} {
      allow read: if request.auth != null && (isSupremeAdmin() || isSameSchoolByName(resource.data.schoolName));
      allow write: if request.auth != null && (isSupremeAdmin() || (isPrincipal() && isSameSchoolByName(resource.data.schoolName)));
    }
  }
}
